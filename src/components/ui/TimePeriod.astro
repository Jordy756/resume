---
import { getCurrentLocale, useTranslations } from '@i18n/utils';
import { getFormattedDate } from '@scripts/utils/handleDates';

interface Props {
  startDate: string;
  endDate: string | null;
  class?: string;
}

const { startDate, endDate, class: className } = Astro.props;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);

const formattedStartDate = getFormattedDate(new Date(startDate), currentLocale, {
  year: 'numeric',
});
const formattedEndDate = endDate
  ? getFormattedDate(new Date(endDate), currentLocale, { year: 'numeric' })
  : t('labels.present');
---

<div class:list={['text-right text-neutral-500 gap-0.5 flex', className]}>
  <time datetime={startDate + ''}>{formattedStartDate}</time>
  <span>-</span>
  <time datetime={endDate + ''}>{formattedEndDate}</time>
</div>
