---
import Section from '@components/chrome/Section.astro';
import TimePeriod from '@components/ui/TimePeriod.astro';
import { getCurrentLocale, useResume, useTranslations } from '@i18n/utils';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const { experiences } = useResume(currentLocale);
---

<Section title={t('experience.title')}>
  <div class="flex flex-col gap-4">
    {experiences.map(({ organization, role, startDate, endDate, highlights }) => (
      <article class="flex flex-col gap-3">
        <header class="flex justify-between gap-2">
          <div class="flex flex-col gap-0.5">
            <h3 class="text-lg font-bold">{organization}</h3>
            <h4 class="text-base">{role}</h4>
          </div>
          <TimePeriod startDate={startDate} endDate={endDate} />
        </header>
        <div class="flex flex-col gap-3">
          <ul class="flex list-inside list-disc flex-col gap-2 pl-4">
            {highlights.map((highlight) => (
              <li class="pl-4 -indent-5">{highlight}</li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</Section>
