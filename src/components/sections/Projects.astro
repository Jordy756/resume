---
import Section from '@components/chrome/Section.astro';
import GithubIcon from '@components/icons/GithubIcon.astro';
import Link from '@components/ui/Link.astro';
import { getCurrentLocale, useResume, useTranslations } from '@i18n/utils';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const { projects } = useResume(currentLocale);
---

<Section title={t('projects.title')} class="print:hidden">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(225px,1fr))] gap-4">
    {projects.map(({ name, description, url, github }) => (
      <article class="flex flex-col gap-2 rounded-sm border p-4">
        <header class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-neutral-800">{name}</h3>
          <figure>
            <GithubIcon width={20} height={20} class="text-neutral-700 transition-[color] hover:text-neutral-900" />
          </figure>
        </header>
        <hr />
        <div class="flex flex-1 flex-col gap-2">
          <p>{description}</p>
        </div>
        <footer class="flex items-center gap-2 mt-2 justify">
          {url && (
            <Link
              class="border px-2 py-1 border-neutral-700 justify-between rounded-xs bg-neutral-700 text-neutral-50"
              href={url}
              aria-label={t('projects.demo.aria', { name })}
              target="_blank"
              rel="noopener noreferrer"
            >
              Demo
            </Link>
          )}
          {github && (
            <Link
              class="border px-2 py-1 justify-between rounded-xs"
              href={github}
              aria-label={t('projects.repo.aria', { name })}
              target="_blank"
              rel="noopener noreferrer"
            >
              Github
            </Link>
          )}
        </footer>
      </article>
    ))}
  </div>
</Section>
