---
import Section from '@components/chrome/Section.astro';
import ExternalIcon from '@components/icons/ExternalIcon.astro';
import Link from '@components/ui/Link.astro';
import TimePeriod from '@components/ui/TimePeriod.astro';
import { getCurrentLocale, useResume, useTranslations } from '@i18n/utils';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const { education } = useResume(currentLocale);
---

<Section title={t('education.title')}>
  {education.map(({ institution, area, startDate, endDate }) => (
    <article>
      <header>
        <header class="flex justify-between gap-2">
          <div class="flex flex-col">
            <h3 class="text-lg">{institution}</h3>
          </div>
          <TimePeriod startDate={startDate} endDate={endDate} />
        </header>
      </header>
      <div class="flex gap-2 items-center justify-between">
        <p>{area}</p>
        <Link class="print:flex hidden" href={''} target="_blank" rel="noopener noreferrer">
          <ExternalIcon width={12} height={12} class="size-3 transition-[color] hover:text-neutral-900" />
        </Link>
      </div>
    </article>
  ))}
</Section>
