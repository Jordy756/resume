---
import Section from '@components/chrome/Section.astro';
import ExternalIcon from '@components/icons/ExternalIcon.astro';
import Link from '@components/ui/Link.astro';
import { getCurrentLocale, useResume, useTranslations } from '@i18n/utils';
import { getFormattedDate } from '@scripts/utils/handleDates';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const { certificates } = useResume(currentLocale);

const groups = Object.entries(certificates).sort(([a], [b]) => Number(b) - Number(a));
---

<Section title={t('sections.certificates.title')}>
  <div class="flex flex-col gap-8">
    {groups.map(([year, items]) => (
      <div class="flex flex-col gap-2">
        <span class="font-bold text-neutral-950">{year}</span>
        <ul class="ml-4 flex flex-col gap-4">
          {items.map(({ name, url, issuer, date }) => {
            const formattedDate = getFormattedDate(date, currentLocale, { month: 'short' });
            const ariaLabel = t('aria.certificate', { name, issuer });
            return (
              <li class="relative gap-y-1 pl-4 before:absolute before:top-0 before:left-0 before:h-[calc(100%+16px)] before:w-px before:bg-neutral-200 after:absolute after:top-1/2 after:left-0 after:h-px after:w-3 after:bg-neutral-200 last:before:h-1/2">
                <article class="grid grid-cols-[30px_1fr] grid-rows-[auto_1fr] gap-x-4">
                  <aside class="row-span-2 flex items-center">
                    <time class="text-center text-xs text-nowrap text-neutral-500 uppercase" datetime={date}>
                      {formattedDate}
                    </time>
                  </aside>
                  <header class="flex items-start justify-between gap-2">
                    <h3 class="text-base">{name}</h3>
                    <Link href={url} aria-label={ariaLabel} title={ariaLabel} target="_blank" rel="noopener noreferrer">
                      <ExternalIcon width={12} height={12} class="size-3 transition-[color] hover:text-neutral-900" />
                    </Link>
                  </header>
                  <div class="flex items-center justify-between gap-2">
                    <p>{issuer}</p>
                  </div>
                </article>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</Section>
